---
// Página de diagnóstico — no enlazada desde ningún sitio
// Visitar: /debug-supabase
const hasUrl = !!import.meta.env.PUBLIC_SUPABASE_URL;
const hasKey = !!import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const urlPreview = import.meta.env.PUBLIC_SUPABASE_URL?.slice(0, 30) + '...' ?? 'NO DEFINIDA';
---
<html lang="es">
<head><meta charset="UTF-8"><title>Diagnóstico Supabase</title>
<style>
  body { font-family: monospace; background: #0f0f0f; color: #e0e0e0; padding: 2rem; max-width: 600px; margin: 0 auto; }
  .ok { color: #4ade80; } .fail { color: #f87171; }
  h2 { color: #a78bfa; }
  pre { background: #1a1a1a; padding: 1rem; border-radius: 8px; white-space: pre-wrap; }
  button { background: #7c3aed; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; cursor: pointer; font-family: monospace; margin-top: 1rem; }
</style>
</head>
<body>
  <h2>Diagnóstico Supabase</h2>

  <p>PUBLIC_SUPABASE_URL: {hasUrl
    ? <span class="ok">✓ DEFINIDA ({urlPreview})</span>
    : <span class="fail">✗ NO DEFINIDA — env var ausente en este build</span>
  }</p>

  <p>PUBLIC_SUPABASE_ANON_KEY: {hasKey
    ? <span class="ok">✓ DEFINIDA</span>
    : <span class="fail">✗ NO DEFINIDA — env var ausente en este build</span>
  }</p>

  <h2>Test de conexión en vivo</h2>
  <pre id="result">Haz clic en "Probar" para ejecutar el test...</pre>
  <button onclick="runTest()">Probar inserción en leads</button>

  <script>
    async function runTest() {
      const pre = document.getElementById('result');
      pre.textContent = 'Ejecutando...';

      try {
        const { supabase } = await import('/src/lib/supabase.js');
        pre.textContent += '\n✓ Módulo supabase cargado';

        const { error } = await supabase.from('leads').insert({
          nombre: 'Test diagnóstico',
          email: 'debug@ecmf.dev',
          empresa: 'Debug',
          mensaje: 'Test automático desde /debug-supabase',
          fuente: 'debug-page'
        });

        if (error) {
          pre.textContent += `\n✗ Error: [${error.code}] ${error.message}`;
        } else {
          pre.textContent += '\n✓ INSERT correcto — lead registrado en Supabase';
        }
      } catch (e) {
        pre.textContent += `\n✗ Excepción: ${e.message}`;
      }
    }
  </script>
</body>
</html>
