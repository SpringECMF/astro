---
import ContactForm from './ContactForm.astro';
---

<section class="hero">
    <div class="bg-glow" aria-hidden="true"></div>
    <div class="container hero-content">

        <span class="hero-brand">El Club de la Mente Fría</span>

        <p class="slogan-problem gradient-text-silver">¿Sabes ese nudo en el estómago cuando piensas en todo lo que te queda por hacer?</p>

        <p class="slogan-solution">Pues imagina que desaparece.</p>

        <p class="slogan-how"><strong>Agentes de IA y automatización de procesos.</strong> Para que tu empresa avance aunque tú no estés mirando.</p>

        <div class="hero-ctas">
            <button id="heroPrimaryBtn" class="btn-hero-primary">Quiero agendar mi demo →</button>
            <a href="#servicios" class="btn-hero-secondary">Ver cómo trabajamos</a>
        </div>

        <div id="heroFormContainer" class="hero-form-wrapper">
            <ContactForm
                title="Muéstrame cómo funcionaría en mi empresa"
                subtitle='Rellena el formulario y vemos tu negocio a lo "mente-fría".'
                cta="Quítame tareas de encima"
                id="hero"
            />
        </div>

    </div>
</section>

<script>
    document.getElementById('heroPrimaryBtn')?.addEventListener('click', () => {
        document.getElementById('heroFormContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
</script>

<style>
    /* ── Space tokens (global) ── */
    :root {
        --space-tight: 1.2rem;
        --space-block: 2rem;
        --space-section: 3rem;
    }
    @media (min-width: 768px) {
        :root {
            --space-tight: 1.5rem;
            --space-block: 3rem;
            --space-section: 5rem;
        }
    }

    /* ── Section ── */
    .hero {
        position: relative;
        overflow: hidden;
        padding: 6rem 2rem 7rem;
        text-align: center;
    }
    @media (max-width: 767px) {
        .hero { padding: 4rem 1.2rem 5rem; }
    }

    /* ── Ambient glow ── */
    .bg-glow {
        position: absolute;
        width: 700px;
        height: 400px;
        bottom: -100px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(123, 47, 190, 0.15);
        filter: blur(80px);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
    }

    /* ── Content wrapper ── */
    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* ── Brand pill ── */
    .hero-brand {
        display: inline-block;
        padding: 0.5rem 1rem;
        border: 1px solid var(--border);
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.02);
        margin-bottom: 3rem;
    }
    @media (max-width: 767px) { .hero-brand { margin-bottom: 2rem; } }

    /* ── Problem ── */
    .slogan-problem {
        font-family: var(--ff-display);
        font-size: clamp(1.1rem, 2.2vw, 1.4rem);
        font-weight: 400;
        line-height: 1.55;
        max-width: 600px;
        margin: 0 auto var(--space-block);
    }
    @media (max-width: 767px) { .slogan-problem { font-size: 1rem; } }

    /* ── Punch ── */
    .slogan-solution {
        font-family: var(--ff-display);
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.02;
        margin-bottom: var(--space-block);
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
    }
    @media (max-width: 767px) { .slogan-solution { font-size: 2.4rem; } }

    /* ── How ── */
    .slogan-how {
        font-size: 1rem;
        color: var(--muted);
        line-height: 1.7;
        max-width: 540px;
        margin: 0 auto var(--space-block);
    }
    .slogan-how strong { color: var(--text); font-weight: 700; }

    /* ── Gradient silver (shared utility) ── */
    .gradient-text-silver {
        background: linear-gradient(180deg, var(--text) 0%, color-mix(in oklab, var(--text) 30%, transparent) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    /* ── CTA group ── */
    .hero-ctas {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: var(--space-block);
    }
    @media (max-width: 480px) {
        .hero-ctas { flex-direction: column; width: 100%; }
        .btn-hero-primary,
        .btn-hero-secondary { width: 100%; justify-content: center; }
    }

    .btn-hero-primary {
        background: var(--brand-gradient);
        color: #fff;
        -webkit-text-fill-color: #fff;
        border: none;
        padding: 1rem 2.2rem;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        box-shadow: 0 8px 30px rgba(233, 30, 140, 0.3);
        display: inline-flex;
        align-items: center;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    @media (min-width: 768px) {
        .btn-hero-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(233, 30, 140, 0.4);
        }
    }

    .btn-hero-secondary {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text);
        -webkit-text-fill-color: var(--text);
        padding: 1rem 1.8rem;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: border-color 0.2s;
    }
    @media (min-width: 768px) {
        .btn-hero-secondary:hover { border-color: var(--muted); }
    }

    /* ── Form wrapper ── */
    .hero-form-wrapper {
        width: 100%;
        max-width: 600px;
        margin-top: var(--space-block);
    }

    /* ── Form internals (kept for ContactForm compatibility) ── */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .span-full { grid-column: 1 / -1; }
    .label-text { display: block; font-size: 0.95rem; color: var(--muted); margin-bottom: 0.5rem; font-weight: 500; }
    .privacy-wrapper .label-text { display: inline; margin-bottom: 0; vertical-align: middle; cursor: pointer; }
    input[type="text"], input[type="email"] {
        width: 100%; background: var(--bg); color: var(--text);
        border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.2rem;
        font-family: var(--ff-body); font-size: 1.1rem; transition: all 0.2s;
    }
    input:focus { outline: none; border-color: var(--brand-purple); box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand-purple) 20%, transparent); }
    .checkbox-container { display: block; position: relative; padding-left: 35px; margin-bottom: 12px; cursor: pointer; user-select: none; }
    .checkbox-container input { position: absolute; opacity: 0; cursor: pointer; height: 0; width: 0; }
    .checkmark { position: absolute; top: 0; left: 0; height: 24px; width: 24px; background-color: var(--bg); border: 1px solid var(--border); border-radius: 50%; transition: all 0.2s; }
    .checkbox-container:hover input ~ .checkmark { border-color: var(--brand-purple); }
    .checkbox-container input:checked ~ .checkmark { background-color: var(--brand-purple); border-color: var(--brand-purple); }
    .checkmark:after { content: ""; position: absolute; display: none; }
    .checkbox-container input:checked ~ .checkmark:after { display: block; }
    .checkbox-container .checkmark:after { left: 8px; top: 4px; width: 5px; height: 10px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); }
    .full-width { width: 100%; justify-content: center; padding: 1.2rem; font-size: 1.2rem; margin-top: 1rem; color: white !important; }
    .form-footer { font-size: 1rem !important; }
    @media (max-width: 640px) {
        .form-grid { grid-template-columns: 1fr; }
    }
</style>
