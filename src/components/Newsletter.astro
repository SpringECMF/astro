---
interface Props {
    variant?: 'mid' | 'footer';
}

const { variant = 'mid' } = Astro.props;

const isFooter = variant === 'footer';
---

<section id={isFooter ? "newsletter-footer" : "newsletter"} class=`newsletter-secondary ${isFooter ? 'footer-style' : ''}`>
    <div class="container newsletter-content">
      {!isFooter && (
        <div class="newsletter-text">
            <h3 class="newsletter-title-alt">¿Todavía no estás listo?</h3>
            <p class="newsletter-comfort">Bien. No pasa nada.</p>
            
            <div class="newsletter-path mt-8">
                <p class="path-label">Empieza por aquí:</p>
                <p class="path-description">Ideas reales de automatización para empresas que no quieren perder más tiempo.</p>
            </div>
        </div>
      )}

      <div class=`newsletter-action ${isFooter ? 'footer-action' : ''}`>
        <div class="newsletter-form-box">
            {isFooter ? (
                <div class="footer-header mb-8">
                    <h3 class="newsletter-title-alt footer-title">Newsletter: IA útil para PYMES</h3>
                    <p class="newsletter-sub-label text-muted">(Puedes darte de baja cuando quieras)</p>
                </div>
            ) : (
                <h4 class="newsletter-label">Newsletter</h4>
            )}
            <form class="newsletter-form" data-form-source={variant} novalidate>
                <div class="nl-field">
                    <input id={isFooter ? "newsEmailFooter" : "newsEmail"} type="email" name="email" placeholder="tu@email.com" required autocomplete="email">
                    <span class="nl-field-error" aria-live="polite"></span>
                </div>
                <div class="privacy-row">
                    <label class="checkbox-container">
                        <input type="checkbox" name="privacy" required>
                        <span class="checkmark"></span>
                        <span class="label-text">He leído y acepto la política de privacidad</span>
                    </label>
                    <span class="nl-field-error privacy-error" aria-live="polite"></span>
                </div>
                <button class="btn btn-primary mt-4 w-full" type="submit">{isFooter ? 'Suscribirme' : 'Recibir ideas útiles'}</button>
                <div class="nl-status" aria-live="polite"></div>
            </form>
        </div>
      </div>
    </div>
</section>

<script>
    import { supabase } from '../lib/supabase.js';

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function setFieldError(form: HTMLFormElement, fieldName: string, msg: string) {
        const input = form.querySelector<HTMLInputElement>(`[name="${fieldName}"]`);
        const errEl = fieldName === 'privacy'
            ? form.querySelector<HTMLElement>('.privacy-error')
            : input?.closest('.nl-field')?.querySelector<HTMLElement>('.nl-field-error');
        if (input) input.classList.toggle('input-error', !!msg);
        if (errEl) errEl.textContent = msg;
    }

    function clearErrors(form: HTMLFormElement) {
        form.querySelectorAll('.nl-field-error').forEach(el => el.textContent = '');
        form.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
    }

    function setStatus(form: HTMLFormElement, msg: string, type: 'success' | 'error' | '') {
        const el = form.querySelector<HTMLElement>('.nl-status');
        if (!el) return;
        el.textContent = msg;
        el.className = `nl-status${type ? ' nl-status--' + type : ''}`;
    }

    document.querySelectorAll('.newsletter-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formEl = e.target as HTMLFormElement;
            const btn = formEl.querySelector<HTMLButtonElement>('button[type="submit"]');
            const data = new FormData(formEl);
            const email = (data.get('email') as string).trim();
            const privacy = data.get('privacy');
            const originalText = btn?.textContent ?? 'Suscribirme';

            clearErrors(formEl);
            setStatus(formEl, '', '');

            let valid = true;
            if (!email) {
                setFieldError(formEl, 'email', 'El email es obligatorio.');
                valid = false;
            } else if (!EMAIL_RE.test(email)) {
                setFieldError(formEl, 'email', 'Introduce un email válido.');
                valid = false;
            }
            if (!privacy) {
                setFieldError(formEl, 'privacy', 'Debes aceptar la política de privacidad.');
                valid = false;
            }
            if (!valid) return;

            if (btn) { btn.textContent = 'Enviando…'; btn.disabled = true; }

            const { error } = await supabase
                .from('newsletter_subscribers')
                .insert({ email, fuente: formEl.dataset.formSource ?? 'desconocido' });

            if (error) {
                if (error.code === '23505') {
                    // Email ya suscrito — tratar como éxito silencioso
                    setStatus(formEl, '¡Ya estás suscrito! Te llegará el siguiente envío.', 'success');
                } else {
                    console.error('[Supabase newsletter]', error.code, error.message);
                    setStatus(formEl, 'Algo salió mal. Por favor inténtalo de nuevo.', 'error');
                    if (btn) { btn.textContent = originalText; btn.disabled = false; }
                    return;
                }
            } else {
                setStatus(formEl, '¡Suscrito! Pronto recibirás la primera entrega.', 'success');
            }

            formEl.reset();
            if (btn) { btn.textContent = originalText; btn.disabled = false; }
        });
    });
</script>

<style>
    .newsletter-secondary {
        padding-top: var(--section-spacing);
        padding-bottom: var(--section-spacing);
        background: color-mix(in oklab, var(--surface) 20%, transparent);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }
    .newsletter-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }
    .newsletter-title-alt {
        font-family: var(--ff-display);
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        margin: 0;
    }
    .newsletter-comfort {
        font-size: 1.4rem;
        color: var(--muted);
        margin-top: 0.5rem;
    }
    .path-label {
        font-weight: 800;
        font-size: 1.1rem;
        color: var(--brand-pink);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }
    .path-description {
        font-size: 1.25rem;
        color: var(--text);
        max-width: 400px;
    }
    .newsletter-form-box {
        background: var(--bg);
        padding: 2.5rem;
        border-radius: 20px;
        border: 1px solid var(--border);
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
        position: relative;
    }
    .footer-style .newsletter-form-box {
        padding: 2rem;
        background: transparent;
        border-color: rgba(255,255,255,0.05);
        box-shadow: none;
    }
    :global(.theme-light) .footer-style .newsletter-form-box {
        border-color: rgba(0,0,0,0.05);
    }

    .newsletter-label {
        font-family: var(--ff-display);
        font-size: clamp(1.4rem, 2.5vw, 1.8rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        margin-bottom: 2rem;
        color: var(--text);
        text-align: left;
    }
    .footer-title { font-size: 1.8rem; text-align: center; }
    .footer-action { width: 100%; max-width: 500px; margin: 0 auto; }
    .footer-style .newsletter-content { display: block; }

    .newsletter-sub-label {
        font-size: 0.9rem;
        margin-top: 0.5rem;
        opacity: 0.7;
    }

    .newsletter-form { display:flex; flex-direction: column; gap: var(--s-3); max-width: 400px; }
    .w-full { width: 100%; }
    .nl-field { display: flex; flex-direction: column; }
    .nl-field-error, .privacy-error {
        font-size: 0.78rem;
        color: var(--brand-pink);
        margin-top: 0.3rem;
        min-height: 1rem;
    }
    .nl-status {
        font-size: 0.9rem;
        padding: 0.6rem 0.9rem;
        border-radius: 8px;
        text-align: center;
        display: none;
    }
    .nl-status--success {
        display: block;
        background: rgba(34,197,94,0.1);
        color: #16a34a;
        border: 1px solid rgba(34,197,94,0.3);
    }
    .nl-status--error {
        display: block;
        background: rgba(233,30,140,0.08);
        color: var(--brand-pink);
        border: 1px solid rgba(233,30,140,0.2);
    }
    :global(.theme-light) .nl-status--success { color: #15803d; }
    .privacy-row { width: 100%; margin-top: 0.5rem; }
    input { 
        background: var(--bg); 
        color: var(--text); 
        border: 1.5px solid var(--border); 
        border-radius: 12px; 
        padding: 1.1rem 1.2rem;
        transition: all 0.2s;
        width: 100%;
    }
    input:focus { outline: none; border-color: var(--brand-pink); box-shadow: 0 0 0 4px rgba(200, 59, 165, 0.1); }

    @media (max-width: 768px) {
        .newsletter-content { grid-template-columns: 1fr; gap: 2rem; text-align: center; }
        .newsletter-title-alt { font-size: 2rem; }
        .newsletter-form { margin: 0 auto; }
        .path-description { margin: 0 auto; }
    }

    /* Circular Checkbox Styles */
    .checkbox-container {
        display: inline-block;
        position: relative;
        padding-left: 30px;
        margin-bottom: 0;
        cursor: pointer;
        user-select: none;
        font-size: 0.9rem;
        color: var(--muted);
    }
    .checkbox-container input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }
    .checkmark {
        position: absolute;
        top: -1px;
        left: 0;
        height: 20px;
        width: 20px;
        background-color: var(--bg);
        border: 1px solid var(--border);
        border-radius: 50%;
        transition: all 0.2s;
    }
    .checkbox-container:hover input ~ .checkmark {
        border-color: var(--brand-purple);
    }
    .checkbox-container input:checked ~ .checkmark {
        background-color: var(--brand-purple);
        border-color: var(--brand-purple);
    }
    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
    }
    .checkbox-container input:checked ~ .checkmark:after {
        display: block;
    }
    .checkbox-container .checkmark:after {
        left: 6px;
        top: 3px;
        width: 4px;
        height: 8px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }
</style>
