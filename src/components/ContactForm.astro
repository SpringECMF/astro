---
interface Props {
    title?: string;
    subtitle?: string;
    cta?: string;
    id?: string;
    isSlim?: boolean;
}

const { 
    title = "Muéstrame cómo funcionaría en mi empresa", 
    subtitle = 'Rellena el formulario y vemos tu negocio a lo "mente-fría".',
    cta = "Quítame tareas de encima",
    id = "contact",
    isSlim = false
} = Astro.props;
---

<div class={`card form-card mx-auto ${isSlim ? 'slim-card' : ''}`} id={`${id}FormContainer`}>
    <div class="form-header">
        <h3 class="form-title">{title}</h3>
        <p>{subtitle}</p>
    </div>
    <form id={`${id}Form`} class="hero-form" data-form-source={id}>
        <input type="text" name="b_check" class="hidden" tabindex="-1" autocomplete="off" style="display:none;">
        
        <div class="form-grid" id={`${id}Grid`}>
            <div class="input-group">
                <label class="label-text" for={`${id}-name`}>Nombre <span class="required">*</span></label>
                <input id={`${id}-name`} name="name" type="text" placeholder="Tu nombre" autocomplete="given-name">
                <span class="field-error" data-for="name" aria-live="polite"></span>
            </div>
            <div class="input-group">
                <label class="label-text" for={`${id}-company`}>Empresa <span class="required">*</span></label>
                <input id={`${id}-company`} name="company" type="text" placeholder="Nombre de tu empresa" autocomplete="organization">
                <span class="field-error" data-for="company" aria-live="polite"></span>
            </div>

            <div class="input-group span-full">
                <label class="label-text" for={`${id}-email`}>Correo Profesional <span class="required">*</span></label>
                <input id={`${id}-email`} name="email" type="email" placeholder="tu@empresa.com" autocomplete="email">
                <span class="field-error" data-for="email" aria-live="polite"></span>
            </div>

            <div class="input-group span-full">
                <label class="label-text" for={`${id}-challenge`}>Tu Reto Actual <span class="required">*</span></label>
                <input id={`${id}-challenge`} name="challenge" type="text" placeholder="¿Qué proceso te roba más tiempo?">
                <span class="field-error" data-for="challenge" aria-live="polite"></span>
            </div>

            <div class="span-full privacy-wrapper">
                <label class="checkbox-container">
                    <input type="checkbox" name="privacy">
                    <span class="checkmark"></span>
                    <span class="label-text">He leído y acepto la política de privacidad <span class="required">*</span></span>
                </label>
                <span class="field-error privacy-error" data-for="privacy" aria-live="polite"></span>
            </div>

            <div class="span-full">
                <button class="btn btn-primary full-width" type="submit">Quítame tareas de encima</button>
            </div>
        </div>

        <div class="form-status-bar" aria-live="polite"></div>
    </form>

    <div class="form-success" style="display:none;" aria-hidden="true">
        <div class="success-icon">✓</div>
        <h4 class="success-title">¡Solicitud recibida!</h4>
        <p class="success-msg">En 24-48 horas nos ponemos en contacto contigo.</p>
    </div>
</div>

<script>
    import { supabase } from '../lib/supabase.js';

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const RULES: Record<string, (v: string) => string> = {
        name:      v => v.trim() ? '' : 'El nombre es obligatorio.',
        company:   v => v.trim() ? '' : 'La empresa es obligatoria.',
        email:     v => !v.trim() ? 'El correo es obligatorio.' : !EMAIL_RE.test(v) ? 'Introduce un correo válido.' : '',
        challenge: v => v.trim() ? '' : 'Cuéntanos tu reto principal.',
    };

    function setFieldError(form: HTMLFormElement, name: string, msg: string) {
        const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
        const errEl = form.querySelector<HTMLElement>(`.field-error[data-for="${name}"]`);
        if (input) input.classList.toggle('input-error', !!msg);
        if (errEl) errEl.textContent = msg;
    }

    function clearAllErrors(form: HTMLFormElement) {
        form.querySelectorAll('.field-error').forEach(el => el.textContent = '');
        form.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        setStatusBar(form, '', '');
    }

    function setStatusBar(form: HTMLFormElement, msg: string, type: 'success' | 'error' | '') {
        const bar = form.closest('.form-card')?.querySelector<HTMLElement>('.form-status-bar');
        if (!bar) return;
        bar.textContent = msg;
        bar.className = `form-status-bar${type ? ' form-status-bar--' + type : ''}`;
    }

    function showSuccess(form: HTMLFormElement) {
        const card = form.closest('.form-card');
        form.style.display = 'none';
        const successEl = card?.querySelector<HTMLElement>('.form-success');
        if (successEl) { successEl.style.display = 'flex'; successEl.removeAttribute('aria-hidden'); }
    }

    document.querySelectorAll<HTMLFormElement>('.hero-form').forEach(form => {
        // Validación en tiempo real al salir del campo
        form.querySelectorAll<HTMLInputElement>('input[name]').forEach(input => {
            input.addEventListener('blur', () => {
                const rule = RULES[input.name];
                if (rule) setFieldError(form, input.name, rule(input.value));
            });
            input.addEventListener('input', () => {
                if (input.classList.contains('input-error')) {
                    const rule = RULES[input.name];
                    if (rule) setFieldError(form, input.name, rule(input.value));
                }
            });
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Honeypot
            const honeypot = form.querySelector<HTMLInputElement>('[name="b_check"]');
            if (honeypot?.value) return;

            clearAllErrors(form);

            const data = new FormData(form);
            let valid = true;

            for (const [field, rule] of Object.entries(RULES)) {
                const msg = rule(data.get(field) as string ?? '');
                if (msg) { setFieldError(form, field, msg); valid = false; }
            }
            if (!data.get('privacy')) {
                setFieldError(form, 'privacy', 'Debes aceptar la política de privacidad.');
                valid = false;
            }
            if (!valid) return;

            const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            const originalText = btn?.textContent ?? 'Enviar';
            if (btn) { btn.textContent = 'Enviando…'; btn.disabled = true; }

            const { error } = await supabase.from('leads').insert({
                nombre:  (data.get('name') as string).trim(),
                email:   (data.get('email') as string).trim(),
                empresa: (data.get('company') as string).trim(),
                mensaje: (data.get('challenge') as string).trim(),
                fuente:  form.dataset.formSource ?? 'desconocido',
            });

            if (error) {
                console.error('[Supabase leads]', error.code, error.message);
                setStatusBar(form, 'Algo salió mal. Por favor inténtalo de nuevo.', 'error');
                if (btn) { btn.textContent = originalText; btn.disabled = false; }
                return;
            }

            showSuccess(form);
        });
    });
</script>

<style>
    .form-card {
        width: 100%; max-width: 650px;
        background: color-mix(in oklab, var(--surface) 90%, transparent);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        padding: 3rem;
        box-shadow: 0 30px 60px -15px rgba(0,0,0,0.6);
        border-radius: 24px;
    }
    .form-title { margin: 0; font-size: 2.2rem; color: var(--text); font-family: var(--ff-display); font-weight: 700; line-height: 1.2; margin-bottom: 0.5rem;}
    .form-header { text-align: center; margin-bottom: 2rem; }
    .form-header p { margin: 0; color: var(--muted); font-size: 1.1rem; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .span-full { grid-column: 1 / -1; }
    .input-group { display: flex; flex-direction: column; }
    .label-text { display: block; font-size: 0.95rem; color: var(--muted); margin-bottom: 0.5rem; font-weight: 500; }
    .privacy-wrapper .label-text { display: inline; margin-bottom: 0; vertical-align: middle; cursor: pointer;}
    .required { color: var(--brand-pink); font-size: 0.85em; }

    /* Error states */
    .field-error {
        font-size: 0.78rem;
        color: var(--brand-pink);
        margin-top: 0.3rem;
        min-height: 1rem;
        display: block;
    }
    .privacy-error { display: block; margin-top: 0.3rem; padding-left: 35px; }
    input.input-error { border-color: var(--brand-pink) !important; }

    /* Form-level status bar */
    .form-status-bar { font-size: 0.9rem; border-radius: 8px; text-align: center; display: none; margin-top: 0.75rem; }
    .form-status-bar--error {
        display: block;
        padding: 0.65rem 1rem;
        background: rgba(233,30,140,0.08);
        color: var(--brand-pink);
        border: 1px solid rgba(233,30,140,0.2);
    }

    /* Success overlay */
    .form-success {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 3rem 2rem;
        gap: 1rem;
    }
    .success-icon {
        width: 56px; height: 56px;
        border-radius: 50%;
        background: rgba(34,197,94,0.15);
        color: #16a34a;
        font-size: 1.6rem;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700;
    }
    .success-title { font-family: var(--ff-display); font-size: 1.6rem; font-weight: 800; color: var(--text); margin: 0; }
    .success-msg { color: var(--muted); font-size: 1rem; margin: 0; }
    
    input[type="text"], input[type="email"] { 
        width: 100%; background: var(--bg); color: var(--text); 
        border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.2rem; 
        font-family: var(--ff-body); font-size: 1.1rem; transition: all 0.2s;
    }
    input:focus { outline: none; border-color: var(--brand-purple); box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand-purple) 20%, transparent); }
    
    /* Circular Checkbox Styles */
    .checkbox-container {
        display: block;
        position: relative;
        padding-left: 35px;
        margin-bottom: 12px;
        cursor: pointer;
        user-select: none;
    }
    .checkbox-container input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }
    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        height: 24px;
        width: 24px;
        background-color: var(--bg);
        border: 1px solid var(--border);
        border-radius: 50%;
        transition: all 0.2s;
    }
    .checkbox-container:hover input ~ .checkmark {
        border-color: var(--brand-purple);
    }
    .checkbox-container input:checked ~ .checkmark {
        background-color: var(--brand-purple);
        border-color: var(--brand-purple);
    }
    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
    }
    .checkbox-container input:checked ~ .checkmark:after {
        display: block;
    }
    .checkbox-container .checkmark:after {
        left: 8px;
        top: 4px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }
    
    .theme-light .form-card {
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05);
    }
    
    .full-width { width: 100%; justify-content: center; padding: 1.2rem; font-size: 1.2rem; margin-top: 1rem; color: white !important; }
    .form-footer { font-size: 1rem !important; margin-top: 1rem;}

    .slim-card {
        padding: 2rem;
        border-radius: 20px;
    }
    .slim-card .form-title {
        font-size: 1.6rem;
    }

    @media (max-width: 640px) {
        .form-grid { grid-template-columns: 1fr; }
        .form-title { font-size: 1.8rem; }
    }
</style>
