<script>
  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');

  faqItems.forEach(item => {
    const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
    const body    = item.querySelector<HTMLElement>('.faq-body');
    if (!trigger || !body) return;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Cierra todos
      faqItems.forEach(other => {
        const t = other.querySelector<HTMLButtonElement>('.faq-trigger');
        const b = other.querySelector<HTMLElement>('.faq-body');
        if (!t || !b) return;
        t.setAttribute('aria-expanded', 'false');
        b.style.maxHeight = '0';
        b.style.opacity   = '0';
        other.classList.remove('is-open');
      });

      // Abre el actual si estaba cerrado
      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
        body.style.opacity   = '1';
        item.classList.add('is-open');
      }
    });
  });
</script>

<style>
  .faq-section {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
    background: color-mix(in oklab, var(--surface) 30%, transparent);
  }

  .faq-heading {
    text-align: center;
  }

  .faq-list {
    max-width: 820px;
    margin: 0 auto;
  }

  /* ── Item ─────────────────────────────────────────── */
  .faq-item {
    border-bottom: 1px solid var(--border);
    transition: border-color 0.25s ease;
  }
  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }
  .faq-item.is-open {
    border-bottom-color: color-mix(in oklab, var(--brand-purple) 55%, var(--border));
  }

  /* ── Trigger ──────────────────────────────────────── */
  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--text);
    transition: color 0.2s ease;
  }
  .faq-trigger:hover {
    color: color-mix(in oklab, var(--brand-pink) 80%, var(--text));
  }
  .faq-trigger:focus-visible {
    outline: 2px solid var(--brand-purple);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .faq-question {
    font-family: var(--ff-display);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.35;
    flex: 1;
  }

  /* ── Chevron ──────────────────────────────────────── */
  .faq-chevron {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .faq-item.is-open .faq-chevron {
    transform: rotate(180deg);
    color: var(--brand-pink);
  }

  /* ── Body / Answer ────────────────────────────────── */
  .faq-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.25s ease;
  }

  .faq-answer {
    margin: 0;
    padding-bottom: var(--s-5);
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  /* ── Mobile ───────────────────────────────────────── */
  @media (max-width: 640px) {
    .faq-trigger {
      padding: var(--s-4) 0;
      gap: var(--s-3);
    }
    .faq-chevron {
      width: 18px;
      height: 18px;
    }
  }
</style>
