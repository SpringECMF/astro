<!-- ═══════════════════════════════════════════
     SECCIÓN 1 — El problema (2-col + timeline)
     ═══════════════════════════════════════════ -->
<section class="vision-section">
    <div class="bg-glow-purple" aria-hidden="true"></div>
    <div class="container">

        <span class="section-eyebrow">El problema</span>

        <div class="vision-grid">

            <!-- Col izquierda: sticky -->
            <div class="vision-left">
                <h1 class="vision-title">
                    Tu empresa, <span class="gradient-text">¿cárcel de tareas...</span><br>
                    o el activo que debería ser?
                </h1>
                <p class="vision-subtitle">Automatización con IA para empresas que no quieren seguir en modo "supervivencia".</p>
            </div>

            <!-- Col derecha: card con timeline -->
            <div class="vision-right">
                <div class="narrative-card">

                    <div class="story-item">
                        <p>Cierras el portátil. La oficina casi vacía. Sales tarde, otra vez.</p>
                    </div>

                    <div class="story-item">
                        <p>¡aaaah!, ¿de verdad ahora? Te acuerdas de esa tarea pendiente. La que sabes hacer con los ojos cerrados, pero te va a robar un par de horas.</p>
                    </div>

                    <div class="story-item highlight">
                        <p>De repente, el cuerpo se llena de una sensación incómoda. La tarea ya es lo de menos. El texto está escrito: <span class="quoted-text">No llego a la cena.</span> Pero tu dedo no se mueve y no es por el cansancio. Es lo que te espera al llegar a casa: ese silencio, esa nada.</p>
                    </div>

                    <div class="story-item emphasis">
                        <p><strong>Mira... el daño que hace:</strong><em>esa indiferencia debería considerarse arma blanca</em></p>
                    </div>

                </div>
            </div>

            <!-- Párrafo puente — span completo en desktop -->
            <p class="narrative-bridge">Si has llegado hasta aquí y esto te suena, lo que viene ahora te interesa. Es algo más que motivación barata.</p>

        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     SECCIÓN 2 — La salida (transición bisagra)
     ═══════════════════════════════════════════ -->
<section class="transition-section">
    <div class="bg-glow-pink" aria-hidden="true"></div>
    <div class="container transition-content">
        <div class="transition-divider"><span>La salida</span></div>
        <h2 class="transition-title">Hay una <span class="salida">salida</span>.<br>Y cabe en una demo de 20 minutos.</h2>
        <p class="transition-sub">Sin humo. Sin rodeos.</p>
    </div>
</section>

<style>
    /* ══════════════════════════════
       SECCIÓN 1 — VISIÓN
       ══════════════════════════════ */

    .vision-section {
        position: relative;
        overflow: hidden;
        padding: var(--space-section, 3rem) 0;
    }

    /* Glow morado — arriba derecha */
    .bg-glow-purple {
        position: absolute;
        width: 500px;
        height: 500px;
        top: -100px;
        right: -150px;
        background: rgba(123, 47, 190, 0.15);
        filter: blur(80px);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
    }

    .vision-section .container { position: relative; z-index: 1; }

    /* Eyebrow */
    .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--brand-pink);
        margin-bottom: 2.5rem;
    }
    .section-eyebrow::before {
        content: '';
        display: inline-block;
        width: 24px;
        height: 1px;
        background: var(--brand-pink);
    }

    /* Grid 2 columnas */
    .vision-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 5rem;
        align-items: start;
    }
    @media (max-width: 767px) {
        .vision-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    /* Columna izquierda: sticky */
    .vision-left {
        position: sticky;
        top: 6rem;
        align-self: start;
    }
    @media (max-width: 767px) {
        .vision-left { position: static; }
    }

    .vision-title {
        font-family: var(--ff-display);
        font-size: clamp(2rem, 3.8vw, 3rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.035em;
        color: var(--text);
        margin-bottom: 1.5rem;
    }
    .gradient-text {
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
    }

    .vision-subtitle {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 380px;
    }

    /* Columna derecha */
    .vision-right {
        display: flex;
        flex-direction: column;
    }

    /* ── Timeline card ── */
    .narrative-card {
        position: relative;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.005));
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2.5rem 2.2rem;
        display: flex;
        flex-direction: column;
    }
    @media (max-width: 767px) {
        .narrative-card { padding: 1.8rem 1.4rem; }
    }

    /* Línea vertical del timeline */
    .narrative-card::before {
        content: '';
        position: absolute;
        left: 2.2rem;
        top: 2.5rem;
        bottom: 2.5rem;
        width: 1px;
        background: linear-gradient(
            180deg,
            transparent,
            rgba(233, 30, 140, 0.3) 30%,
            rgba(123, 47, 190, 0.3) 70%,
            transparent
        );
        pointer-events: none;
    }
    @media (max-width: 767px) {
        .narrative-card::before { left: 1.4rem; top: 1.8rem; bottom: 1.8rem; }
    }

    /* ── Story items ── */
    .story-item {
        position: relative;
        padding: 0 0 1.5rem 1.5rem;
    }
    .story-item:last-child { padding-bottom: 0; }

    /* Punto del timeline — estado base */
    .story-item::before {
        content: '';
        position: absolute;
        left: -4px;
        top: 0.4rem;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 2px solid var(--muted);
        background: transparent;
        z-index: 1;
    }

    .story-item p {
        font-size: 0.95rem;
        color: var(--muted);
        line-height: 1.7;
        margin: 0;
    }

    /* Highlight — "No llego a la cena" */
    .story-item.highlight::before {
        border-color: var(--brand-pink);
        background: var(--brand-pink);
        box-shadow: 0 0 0 4px rgba(233, 30, 140, 0.15);
    }
    .story-item.highlight p {
        color: var(--text);
        font-style: italic;
        font-size: 1rem;
    }
    .quoted-text {
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
        font-style: normal;
    }

    /* Emphasis — "Joder… el daño que hace" */
    .story-item.emphasis {
        margin: 0.5rem 0 0 -1.5rem;
        padding: 1rem 1.2rem 1rem 2.4rem;
        background: rgba(123, 47, 190, 0.06);
        border-left: 3px solid var(--brand-purple);
        border-radius: 0 8px 8px 0;
    }
    .story-item.emphasis::before {
        left: calc(1.5rem - 4px);
        top: 1.1rem;
        width: 11px;
        height: 11px;
        border-color: var(--brand-purple);
        background: var(--brand-purple);
        box-shadow: 0 0 0 5px rgba(123, 47, 190, 0.2);
    }
    .story-item.emphasis p {
        color: var(--text);
        font-size: 1rem;
        font-weight: 500;
        font-style: normal;
    }
    .story-item.emphasis strong { font-weight: 700; display: block; margin-bottom: 0.25rem; }
    .story-item.emphasis em { font-style: italic; }

    /* Párrafo puente — span completo del grid */
    .narrative-bridge {
        grid-column: 1 / -1;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 500;
        max-width: 600px;
        margin: var(--space-block, 2rem) auto 0;
        line-height: 1.6;
    }
    @media (max-width: 767px) {
        .narrative-bridge { grid-column: auto; }
    }

    /* ══════════════════════════════
       SECCIÓN 2 — TRANSICIÓN
       ══════════════════════════════ */

    .transition-section {
        position: relative;
        overflow: hidden;
        padding: var(--space-section, 3rem) 2rem;
        text-align: center;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: linear-gradient(180deg, transparent, rgba(123, 47, 190, 0.04), transparent);
    }
    @media (max-width: 767px) {
        .transition-section { padding: var(--space-block, 2rem) 1.2rem; }
    }

    /* Glow fucsia — centro */
    .bg-glow-pink {
        position: absolute;
        width: 600px;
        height: 300px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(233, 30, 140, 0.12);
        filter: blur(80px);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
    }

    .transition-content {
        position: relative;
        z-index: 1;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Divider tipográfico */
    .transition-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .transition-divider::before,
    .transition-divider::after {
        content: '';
        height: 1px;
        width: 60px;
    }
    .transition-divider::before {
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3));
    }
    .transition-divider::after {
        background: linear-gradient(90deg, rgba(255,255,255,0.3), transparent);
    }
    @media (max-width: 767px) {
        .transition-divider::before,
        .transition-divider::after { width: 30px; }
    }
    .transition-divider span {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        opacity: 0.7;
    }

    .transition-title {
        font-family: var(--ff-display);
        font-size: clamp(2.3rem, 5vw, 4.5rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.04em;
        color: var(--text);
        margin-bottom: 1rem;
    }

    .salida {
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .transition-sub {
        font-size: 1rem;
        color: var(--muted);
        margin-top: 1rem;
    }

    /* ── Light mode overrides ── */
    :global(.theme-light) .bg-glow-purple { background: rgba(123, 47, 190, 0.07); }
    :global(.theme-light) .bg-glow-pink   { background: rgba(233, 30, 140, 0.05); }
    :global(.theme-light) .narrative-card {
        background: linear-gradient(180deg, rgba(0,0,0,0.01), rgba(0,0,0,0.004));
    }
    :global(.theme-light) .story-item.emphasis { background: rgba(123, 47, 190, 0.04); }
    :global(.theme-light) .transition-divider::before {
        background: linear-gradient(90deg, transparent, rgba(0,0,0,0.15));
    }
    :global(.theme-light) .transition-divider::after {
        background: linear-gradient(90deg, rgba(0,0,0,0.15), transparent);
    }
</style>
